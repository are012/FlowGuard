# SQLite is the zero-dependency local default. PostgreSQL URLs are supported.
DATABASE_URL=sqlite:///./flowguard.db

# Comma-separated browser origins allowed to call the API.
FLOWGUARD_CORS_ORIGINS=http://localhost:3000

# MVP identity when no X-User-ID header is supplied.
FLOWGUARD_DEMO_USER_ID=demo-user

# Maximum accepted UTF-8 CSV upload size.
FLOWGUARD_MAX_CSV_BYTES=5242880

# Optional GPT-5.6 Luna investigator. With no key, FlowGuard records an explicit
# deterministic fallback trace and keeps the existing financial workflow usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
FLOWGUARD_AGENT_MODE=auto

# SQLite is the zero-dependency local default. PostgreSQL URLs are supported.
DATABASE_URL=sqlite:///./flowguard.db

# Comma-separated browser origins allowed to call the API.
FLOWGUARD_CORS_ORIGINS=http://localhost:3000

# MVP identity when no X-User-ID header is supplied.
FLOWGUARD_DEMO_USER_ID=demo-user

# Maximum accepted UTF-8 CSV upload size.
FLOWGUARD_MAX_CSV_BYTES=5242880

# SQLite is the zero-dependency local default. PostgreSQL URLs are supported.
DATABASE_URL=sqlite:///./flowguard.db
# Application entrypoints expect `alembic upgrade head` to have run.
FLOWGUARD_AUTO_CREATE_SCHEMA=false

# Comma-separated browser origins allowed to call the API.
FLOWGUARD_CORS_ORIGINS=http://localhost:3000

# Structured application logs and process-local protection for costly endpoints.
FLOWGUARD_LOG_LEVEL=INFO
FLOWGUARD_RATE_LIMIT_ENABLED=true
FLOWGUARD_IMPORT_RATE_LIMIT_PER_MINUTE=10
FLOWGUARD_ANALYSIS_RATE_LIMIT_PER_MINUTE=5

# MVP identity when no X-User-ID header is supplied.
FLOWGUARD_DEMO_USER_ID=demo-user

# Maximum accepted UTF-8 CSV upload size.
FLOWGUARD_MAX_CSV_BYTES=5242880

# Isolated AI interpretation service. The API never owns an OpenAI credential.
FLOWGUARD_AI_SERVER_URL=http://localhost:8001
FLOWGUARD_AI_CONNECT_TIMEOUT_SECONDS=3
FLOWGUARD_AI_RESPONSE_TIMEOUT_SECONDS=10
FLOWGUARD_AI_TOTAL_TIMEOUT_SECONDS=15
FLOWGUARD_AI_MAX_RETRIES=1
FLOWGUARD_AI_LOCALE=ko-KR

# Audit metadata only. Model selection belongs to the AI service process.
FLOWGUARD_AI_MODEL_NAME=gpt-5.6-luna
